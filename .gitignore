# ---------------------------------------------------------------------------
# Projecta PMO Intelligence — exclusiones de control de versiones.
# ---------------------------------------------------------------------------
# Este archivo SÍ se versiona. Lista todo lo que NO debe entrar al repositorio.
# ---------------------------------------------------------------------------

# --- Secretos y configuración local ---------------------------------------
# El archivo `.env` contiene la clave de firma y las credenciales locales.
# NUNCA se versiona: solo se versiona la plantilla `.env.example`.
.env
.env.*
!.env.example

# --- Entornos virtuales y dependencias ------------------------------------
.venv/
venv/
env/
ENV/
node_modules/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Datos locales de la validación ----------------------------------------
# Base de datos de humo y artefactos generados en desarrollo.
.data/
*.db
*.sqlite
*.sqlite3

# --- Resultados de pruebas y herramientas ----------------------------------
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Sistema operativo y editores -------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Planificaciones internas de Mavis (no forman parte del producto) ------
.mavis/

# --- Artefactos de ejecución que sí aparecen en este proyecto --------------
# Ficheros del planificador de Celery: los escribe el proceso beat en su
# directorio de trabajo. No deben versionarse: son estado, no código.
celerybeat-schedule*
celerybeat.pid
*.pid

# Volcado del broker Redis: estado, no código.
*.rdb

# Logs de ejecución.
*.log

# Entornos y herramientas de desarrollo que no son parte del producto.
.envrc
.ipynb_checkpoints
.hypothesis
.mypy_cache/
.ruff_cache/
.pytest_cache/
