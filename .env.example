# =============================================================================
#  Projecta PMO Intelligence — plantilla de variables de entorno
#  «Decide con evidencia. Avanza con control.»
#
#  Uso:
#      cp .env.example .env
#      $EDITOR .env
#
#  ── EL ARCHIVO `.env` NUNCA SE VERSIONA ───────────────────────────────────
#  `.env` contiene credenciales reales (SECRET_KEY, contraseña de PostgreSQL y
#  credenciales de MinIO). No debe subirse a git, ni pegarse en tickets o
#  chats, ni archivarse en un artefacto de CI. Está excluido en `.gitignore`
#  y en `.dockerignore`: manténlo fuera del control de versiones. Al
#  repositorio solo entra esta plantilla, sin ningún secreto.
#
#  Todos los valores de ejemplo son marcadores de posición: `cambiar-en-produccion`.
#  Sustitúyelos por valores reales antes de levantar el stack. Para generar la
#  SECRET_KEY:
#      openssl rand -hex 32
#
#  Contrato de variables: docs/skeleton/design.md, sección «Contrato de
#  configuración».
#
#  Nota sobre Docker Compose: el `docker-compose.yml` fija las URLs internas
#  de la red de Compose (postgres, redis, minio). Los valores de esta
#  plantilla apuntan a `localhost` y son los válidos para ejecutar la
#  aplicación de forma nativa, fuera de Docker.
# =============================================================================

# --- Aplicación -----------------------------------------------------------
APP_NAME=Projecta PMO Intelligence
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# OBLIGATORIA y sin valor por defecto: la aplicación falla al arrancar
# nombrando la variable si falta. Generar con `openssl rand -hex 32`.
SECRET_KEY=cambiar-en-produccion

# --- Base de datos --------------------------------------------------------
# Driver de producción del contrato: postgresql+asyncpg.
# Fuera de Docker, el host es `localhost`; dentro de la red de Compose lo
# reescribe el servicio `postgres` (ver docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://postgres:cambiar-en-produccion@localhost:5432/projecta

# --- PostgreSQL (servicio `postgres`) -------------------------------------
# POSTGRES_USER está fijado a `postgres` en el docker-compose.yml porque el
# healthcheck (`pg_isready -U postgres`) lo referencia: si lo cambias aquí,
# actualiza también el healthcheck del compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar-en-produccion
POSTGRES_DB=projecta

# --- Redis (servicio `redis`) ---------------------------------------------
# 0 → caché y locks de la aplicación; 1 → broker de Celery; 2 → resultados.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- MinIO (servicio `minio`, perfil opcional `minio`) --------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=cambiar-en-produccion
MINIO_SECRET_KEY=cambiar-en-produccion
MINIO_BUCKET=projecta-evidencia
# Credenciales raíz del servidor MinIO. Deben tener el mismo valor que
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY: la aplicación autentica contra el
# servidor MinIO con ese par.
MINIO_ROOT_USER=cambiar-en-produccion
MINIO_ROOT_PASSWORD=cambiar-en-produccion

# --- Autenticación y sesiones --------------------------------------------
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
# Orígenes permitidos separados por comas. Vacío = CORS deshabilitado.
CORS_ORIGINS=

# --- Identidad corporativa (OIDC) -----------------------------------------
# Proveedor OpenID Connect de la organización. Sin estas cuatro variables el
# flujo OIDC no está disponible y solo queda el inicio de sesión local, que
# la aplicación rechaza en producción.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
OIDC_SCOPES=openid profile email
# Dominio del que se deduce la organización si el proveedor no entrega el
# claim `organization`. Vacío = no se deduce.
OIDC_DOMINIO_ORGANIZACION=

# --- Observabilidad (perfil `observabilidad`) ----------------------------
# Credenciales del administrador de Grafana. Cámbialas: son las que abren
# el panel.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar-en-produccion
# Endpoint del colector OpenTelemetry. Vacío = la aplicación arranca sin
# trazas, pero sigue exponiendo métricas.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# DSN de Sentry. Vacío = los errores no controlados solo se registran en el
# log de la aplicación.
SENTRY_DSN=

# --- Projecta Capture: transcripción ---------------------------------------
# Vacía = proveedor simulado. Es lo que permite que el MVP funcione entero
# sin credenciales y sin sacar audio del perímetro. Si se configura una URL,
# el audio sale del banco, y eso es una decisión explícita que hay que
# tomar, no un valor por defecto.
CAPTURA_MOTOR_TRANSCRIPCION_URL=
CAPTURA_MOTOR_TRANSCRIPCION_TOKEN=

# --- Railway ---------------------------------------------------------------
# En Railway **no** hay fichero `.env`: las variables se fijan en el
# panel, por servicio y por entorno, y Railway las inyecta en el
# proceso. Estas líneas documentan **qué** hay que fijar y con qué
# nombre; los valores salen de Railway, no de aquí.
#
# PostgreSQL (servicio `postgres`):
#   DATABASE_URL=${{postgres.DATABASE_URL}}
#     Railway entrega la URL con el driver **síncrono** (`postgresql://`).
#     La aplicación la normaliza a `postgresql+asyncpg://` al arrancar, y
#     de ahí deriva la versión síncrona para Alembic. No hay que tocar
#     nada a mano.
#
# Redis (servicio `redis`):
#   REDIS_URL=${{redis.REDIS_URL}}
#     El broker de Celery y el backend de resultados se **derivan** de
#     esta variable, con las bases de datos 1 y 2. Railway ofrece un
#     solo Redis. Si se fijan `CELERY_BROKER_URL` y
#     `CELERY_RESULT_BACKEND` explícitamente, mandan esas.
#
# Almacenamiento de objetos (servicio `minio`):
#   MINIO_ENDPOINT=http://minio.railway.internal:9000
#   MINIO_ACCESS_KEY=${{minio.MINIO_ROOT_USER}}
#   MINIO_SECRET_KEY=${{minio.MINIO_ROOT_PASSWORD}}
#
# Secreto de firma (variable **compartida**):
#   SECRET_KEY=${{shared.SECRET_KEY}}
#     En producción, **sellada**: una variable sellada no se puede leer
#     desde el panel. Generar con `openssl rand -hex 32`.
#
# Lo que NO se fija, porque Railway lo da solo:
#   PORT, RAILWAY_PUBLIC_DOMAIN, RAILWAY_PRIVATE_DOMAIN
